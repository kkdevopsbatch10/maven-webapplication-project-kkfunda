node
{
 def mavenHome=tool name: "maven-3.9.16"
 stage ('git checkout')
 {
  git branch: 'master', url: 'https://github.com/kkdevopsbatch10/maven-webapplication-project-kkfunda.git'
 }
 stage ('compile')
 {
  sh "${mavenHome}/bin/mvn compile"
 }
 stage ('Build Stage')
 {
  sh "${mavenHome}/bin/mvn clean package"
 }
  stage ('SQ Report')
 {
  sh "${mavenHome}/bin/mvn sonar:sonar "
 }
   stage ('Nexus Report')
 {
  sh "${mavenHome}/bin/mvn deploy"
 }
 stage('Deploy to Tomcat') 
    {
      
      sh """

      curl -u admin:Abhimanyu@3698 \
--upload-file /var/lib/jenkins/workspace/javahome/target/maven-web-application.war \
"http://54.164.10.95:8089/manager/text/deploy?path=/maven-web-application&update=true"
          
        """
    }
}
